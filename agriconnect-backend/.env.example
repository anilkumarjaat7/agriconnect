# Copy this file to agriconnect-backend/.env and replace the placeholders with your own
# test-mode credentials. The real .env file is ignored by Git - never commit it.
# Real OS environment variables still override anything set here.

# Razorpay (Test Mode only: the Key ID must start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# data.gov.in / AGMARKNET API key (free, generated from "My Account")
MANDI_API_KEY=your_data_gov_in_api_key
